RewriteEngine On

# Route /invoice-templates through PHP (prevent directory listing)
RewriteRule ^invoice-templates/?$ index.php/$0 [QSA,L]

# Allow direct access to existing files (assets)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route everything else through index.php and pass the path as PATH_INFO
RewriteRule ^(.*)$ index.php/$1 [QSA,L]
